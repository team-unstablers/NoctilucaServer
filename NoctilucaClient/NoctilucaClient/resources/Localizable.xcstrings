    "session-settings.projection.codec_list.template.mjpg.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A video codec used in traditional remote desktop environments.\nSuitable for displaying frequently changing content in virtual machine environments."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "전통적인 원격 데스크톱 환경에서 사용되는 비디오 코덱입니다.\n가상 머신 환경에서 화면 변경이 잦은 컨텐츠를 표시해야 하는 경우 적합합니다."
          }
        }
      }
    },
    "session-settings.projection.codec_list.template.mjpg.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion JPEG"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Motion JPEG"
          }
        }
      }
    },
    "session-settings.projection.codec_list.template.webp.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use tiled WebP.\nBetter compression than MJPG but uses more resources.\nSuitable for displaying frequently changing content in virtual machine environments."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "타일링된 WebP를 사용합니다.\nMJPG보다 압축 효율이 좋지만 리소스를 더 많이 사용합니다.\n가상 머신 환경에서 화면 변경이 잦은 컨텐츠를 표시해야 하는 경우 적합합니다."
          }
        }
      }
    },
