    "settings.input.mouse_redirection.touch_mode.touch.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch position maps directly to cursor position. Tap to move+click, drag to click+drag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タッチ位置がそのままカーソル位置になります。タップは移動+クリック、ドラッグはクリック+ドラッグとして処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "터치 위치가 곧 커서 위치가 됩니다. 탭은 이동+클릭, 드래그는 클릭+드래그로 처리합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触摸位置即为光标位置。轻点为移动+点击，拖动为点击+拖动。"
          }
        }
      }
    },
    "settings.input.mouse_redirection.touch_mode.touch.label" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch Mode (Default)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タッチモード (デフォルト)"
          }
