    "session-settings.input.hack.hangul_toggle_desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emulate Windows-style Han/Eng toggling.\nUse Right ⌘ (Command) and ⌥ (Option) keys for Han/Eng switching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windowsスタイルの日/英(韓/英)切り替え動作をエミュレートします。\n右⌘ (Command)キーと ⌥ (Option)キーを日/英(韓/英)切り替えとして使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows 스타일의 한/영 전환 동작을 에뮬레이트합니다.\n오른쪽 ⌘ (Command)키와 ⌥ (Option) 키를 한/영 전환으로 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟 Windows 风格的中/英切换行为。\n使用右侧 ⌘ (Command) 键和 ⌥ (Option) 键进行中/英切换。"
          }
        }
      }
    },
    "session-settings.input.keyboard_hacks" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard Hack Settings"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードハック (Hack) 設定"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "키보드 핵 (Hack) 설정"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘 Hack 设置"
          }
        }
      }
    },
    "session-settings.input.keyboard_hacks_desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request the server to modify or augment keyboard behavior for user convenience.\n- Not all servers support these hacks.\n- Some hacks are mutually exclusive. Unexpected behavior may occur if used simultaneously."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーの利便性のためにキーボード動作を修正したり補完するようサーバーに要求します。\n- すべてのサーバーがこのHackをサポートしているわけではありません。\n- 一部のHackは相互排他的です。同時使用時に予期しない動作が発生する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자 편의를 위해 키보드 동작을 수정하거나 보완하도록 서버에 요청합니다.\n- 모든 서버가 이 Hack들을 지원하는 것은 아닙니다.\n- 일부 Hack은 상호 배타적입니다. 동시 사용 시 예기치 않은 동작이 발생할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求服务器修改或补充键盘行为以方便用户。\n- 并非所有服务器都支持这些 Hack。\n- 部分 Hack 互斥。同时使用可能会导致意外行为。"
          }
        }
      }
    },
