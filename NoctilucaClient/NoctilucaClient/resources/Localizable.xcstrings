    "session-settings.transfer.clipboard.allow_file.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure whether to allow copying files through clipboard copy/paste operations such as ⌘C / ⌘V."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘C / ⌘Vなどのクリップボードのコピー/ペースト操作を通じてファイルをコピーすることを許可するかどうかを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌘C / ⌘V와 같은 클립보드 복사/붙여넣기 동작을 통해 파일을 복사하는 것을 허용할지 여부를 설정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置是否允许通过 ⌘C / ⌘V 等剪贴板复制/粘贴操作来复制文件。"
          }
        }
      }
    },
    "session-settings.transfer.clipboard.allow_file.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
