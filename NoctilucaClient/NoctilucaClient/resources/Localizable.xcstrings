    "auth.identity.fingerprint_mismatch_format" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` presented a certificate, but the fingerprint is different from the last connection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`で証明書を提示しましたが、証明書のフィンガープリントが前回接続時と異なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "`%@`에서 인증서를 제시했지만, 인증서 지문이 저번에 접속했을 때와 다릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` 出示了证书，但证书指纹与上次连接时不同。"
          }
        }
      }
    },
    "auth.identity.fingerprint_mismatch.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
