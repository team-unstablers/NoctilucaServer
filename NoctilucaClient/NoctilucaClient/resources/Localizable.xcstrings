          }
        }
      }
    },
    "settings.security.tls_validation.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set validation level for server SSL/TLS certificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーのSSL/TLS証明書の検証レベルを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "서버의 SSL/TLS 인증서의 유효성 검사 수준을 설정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置服务器 SSL/TLS 证书的验证级别。"
          }
        }
      }
    },
    "settings.security.tls_validation.strict.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strictly validate server SSL/TLS certificates against the system trust store.\nConnections to hosts using self-signed certificates may fail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのトラストストアを基準にサーバーのSSL/TLS証明書を厳格に検証します。\n自己署名証明書を使用中のホストの場合、接続に失敗する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "시스템의 트러스트 스토어를 기준으로 서버의 SSL/TLS 인증서를 엄격하게 검사합니다.\n자가 서명 인증서를 사용 중인 호스트의 경우 연결에 실패할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据系统信任存储库严格检查服务器的 SSL/TLS 证书。\n如果是使用自签名证书的主机，连接可能会失败。"
          }
        }
      }
    },
    "settings.security.tls_validation.strict.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strict"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厳格に"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "엄격히"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严格"
          }
        }
      }
    },
    "settings.security.tls_validation.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Validation Policy"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検証ポリシー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "유효성 검사 정책"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证策略"
          }
        }
      }
    },
    "settings.security.tls_validation.unsafe.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not validate the server's SSL/TLS certificate.\nNot recommended as it is vulnerable to Man-in-the-Middle (MITM) attacks where a third party could eavesdrop on or tamper with communication."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーのSSL/TLS証明書の検証を行いません。\n第三者が通信内容を盗聴したり改ざんする中間者攻撃 (MITM) に脆弱なため推奨しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "서버의 SSL/TLS 인증서의 유효성 검사를 수행하지 않습니다.\n제 3자가 통신 내용을 훔쳐보거나 변조하는 중간자 공격 (MITM)에 취약하므로 권장하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不验证服务器的 SSL/TLS 证书有效性。\n这容易受到第三方窃听或篡改通信内容的中间人攻击 (MITM) 威胁，因此不建议使用。"
          }
        }
      }
    },
    "settings.security.tls_validation.unsafe.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do Not Perform **(Dangerous!)**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検証しない **(危険!)**"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "수행하지 않기 **(위험!)**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不执行 **(危险!)**"
          }
        }
      }
    },
