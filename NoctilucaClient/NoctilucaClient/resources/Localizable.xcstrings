    "settings.projection.audio_policy.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set policies related to audio projection behavior."
          }
        },
        "ja" : {
          "stringUnit" : {
