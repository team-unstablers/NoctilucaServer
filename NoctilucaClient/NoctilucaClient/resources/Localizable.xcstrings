    "session-settings.projection.audio_codec_list.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set priority of audio codecs. Codecs with higher priority are attempted first during negotiation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用するオーディオコーデックの優先順位を設定します。優先順位が高いコーデックからサーバーとネゴシエーションを試みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용할 오디오 코덱의 우선순위를 설정합니다. 우선순위가 높은 코덱부터 서버와 협상을 시도합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置要使用的音频编解码器的优先级。将按照优先级从高到低的顺序尝试与服务器协商。"
          }
        }
      }
    },
