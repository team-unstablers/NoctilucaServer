        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボード入力をリモートコンピューターにリダイレクトする方法を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "키보드 입력을 원격 컴퓨터로 리디렉션하는 방법을 설정합니다."
          }
        },
        "zh-Hans" : {
