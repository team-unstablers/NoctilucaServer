    "session-settings.projection.codec_list.template.mjpg.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A video codec used in traditional remote desktop environments.\nSuitable for displaying frequently changing content in virtual machine environments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "従来の遠隔デスクトップ環境で使用されるビデオコーデックです。\n仮想マシン環境で画面変更が頻繁なコンテンツを表示する必要がある場合に適しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "전통적인 원격 데스크톱 환경에서 사용되는 비디오 코덱입니다.\n가상 머신 환경에서 화면 변경이 잦은 컨텐츠를 표시해야 하는 경우 적합합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于传统远程桌面环境的视频编解码器。\n适合在虚拟机环境下显示画面变化频繁的内容。"
          }
        }
      }
    },
    "session-settings.projection.codec_list.template.mjpg.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion JPEG"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion JPEG"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
