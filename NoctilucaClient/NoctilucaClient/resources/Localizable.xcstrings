    "settings.projection.video_policy.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set policies related to screen projection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面プロジェクションに関連するポリシーを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "화면 프로젝션과 관련된 정책을 설정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置屏幕投影相关的策略。"
          }
        }
      }
    },
    "settings.projection.video_policy.fast.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display screen data as soon as it arrives.\nDelay is minimal, but network jitter may cause some visual discomfort."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面データが到着し次第、最大限速く表示します。\n遅延は少ないですが、ネットワークジッター(Jitter)により若干の不快感を感じる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "화면 데이터가 도착하는 대로 최대한 빠르게 표시합니다.\n딜레이는 적지만, 네트워크 지터(Jitter)로 인하여 약간의 불쾌감이 들 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面数据到达后尽快显示。\n虽然延迟较低，但由于网络抖动 (Jitter) 可能会产生轻微的不适感。"
          }
        }
      }
    },
    "settings.projection.video_policy.fast.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display As Fast As Possible"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大限速く表示する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최대한 빠르게 표시하기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽快显示"
          }
        }
      }
    },
    "settings.projection.video_policy.jitter_buffer.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attempts to buffer screen data and play it back at regular intervals.\nScreen display delay increases slightly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面データを少しずつ溜めておき、一定の間隔で再生しようとします。\n画面表示の遅延が少し増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "화면 데이터를 조금씩 모아두었다가 일정한 간격으로 재생하려 노력합니다.\n화면 표시 딜레이가 조금 늘어납니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "努力积攒少量屏幕数据后按固定间隔播放。\n屏幕显示的延迟会略微增加。"
          }
        }
      }
    },
