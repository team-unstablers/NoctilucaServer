    "settings.projection.jitter_buffer.low_latency.desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aims to reduce latency.\nUse this when the network condition is good."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅延時間を減らすことを目標にします。\nネットワークの状態が良い場合に使用してください。"
          }
        },
        "ko" : {
