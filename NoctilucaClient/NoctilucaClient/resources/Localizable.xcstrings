    "settings.input.mouse_redirection.pointer_mode.automatic.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically switch when a hardware mouse is connected, and revert to touch pointer when disconnected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアマウスが接続されると自動的に切り替わり、接続が解除されるとタッチポインタに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "하드웨어 마우스가 연결되면 자동으로 전환하고, 연결이 해제되면 터치 포인터로 복귀합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接硬件鼠标时自动切换，断开连接后恢复为触摸指针。"
          }
        }
      }
    },
    "settings.input.mouse_redirection.pointer_mode.automatic.label" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic (Recommended)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動切替 (推奨)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자동 전환 (권장)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动切换 (推荐)"
          }
        }
      }
    },
    "settings.input.mouse_redirection.pointer_mode.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determine whether to use touch input or hardware mouse input."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タッチ入力とハードウェアマウス入力のどちらのソースを使用するか決定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "터치 입력과 하드웨어 마우스 입력 중 어떤 소스를 사용할지 결정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "决定使用触摸输入还是硬件鼠标输入作为来源。"
          }
        }
      }
    },
    "settings.input.mouse_redirection.pointer_mode.hardware_mouse.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritize hardware mouse if available. Touch input is ignored while a hardware mouse is connected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能な場合、ハードウェアマウスを優先して使用します。ハードウェアマウスが接続されている間、タッチ入力は無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
