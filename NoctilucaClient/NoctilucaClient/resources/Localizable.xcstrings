    "settings.security.protocol.disable_version_announcement.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not announce the client version to the server.\nSome servers may refuse connection or limit functionality."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クライアントバージョンをサーバーに通知しません。\n一部のサーバーでは接続を拒否したり機能を制限したりする場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "클라이언트 버전을 서버에게 알리지 않습니다.\n일부 서버에서는 접속을 거절하거나 기능을 제한할 수도 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不向服务器通报客户端版本。\n部分服务器可能会拒绝连接或限制功能。"
          }
        }
      }
    },
