          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sirius 프로토콜의 동작 방식을 구성합니다."
          }
        }
      }
    },
    "settings.security.tls_validation.default.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accommodates the situation where not all hosts can get SSL/TLS certificates from trusted CAs.\nDisplays a warning popup for hosts using self-signed certificates."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 호스트가 신뢰받은 인증 기관으로부터 SSL/TLS 인증서를 발급받을 수 없다는 상황을 감안합니다.\n자가 서명 인증서를 사용한 호스트의 경우 경고 팝업을 표시합니다."
          }
        }
      }
    },
    "settings.security.tls_validation.default.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기본"
          }
        }
      }
    },
    "settings.security.tls_validation.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set validation level for server SSL/TLS certificate."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "서버의 SSL/TLS 인증서의 유효성 검사 수준을 설정합니다."
          }
        }
      }
    },
    "settings.security.tls_validation.strict.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strictly validate server SSL/TLS certificates against the system trust store.\nConnections to hosts using self-signed certificates may fail."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "시스템의 트러스트 스토어를 기준으로 서버의 SSL/TLS 인증서를 엄격하게 검사합니다.\n자가 서명 인증서를 사용 중인 호스트의 경우 연결에 실패할 수 있습니다."
          }
        }
      }
    },
    "settings.security.tls_validation.strict.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strict"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "엄격히"
          }
        }
      }
    },
    "settings.security.tls_validation.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Validation Policy"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "유효성 검사 정책"
          }
        }
      }
    },
    "settings.security.tls_validation.unsafe.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not validate the server's SSL/TLS certificate.\nNot recommended as it is vulnerable to Man-in-the-Middle (MITM) attacks where a third party could eavesdrop on or tamper with communication."
          }
        },
        "ko" : {
