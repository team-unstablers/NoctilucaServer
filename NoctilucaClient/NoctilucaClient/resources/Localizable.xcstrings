    },
    "session-settings.projection.negotiation_desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set codec negotiation policy with server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーとのコーデックネゴシエーションポリシーを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "서버와의 코덱 협상 정책을 설정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置与服务器的编解码器协商策略。"
          }
        }
      }
    },
    "session-settings.projection.negotiation.mandatory" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requirements First"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求事項優先"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "요구 사항 우선"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求优先"
          }
        }
      }
    },
    "session-settings.projection.negotiation.mandatory_desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark all user-specified codec requirements as mandatory.\nNegotiation may fail if the server cannot meet the requirements.\nAlso, requirements may be ignored depending on the server's codec negotiation policy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーが指定したコーデック関連の要求事項をすべて必須のものとしてマークします。\nサーバーが要求事項を満たせない場合、ネゴシエーションに失敗する可能性があります。\nまた、サーバー側のコーデックネゴシエーションポリシーによって要求事項が無視される場合もあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자가 지정한 코덱 관련 요구 사항을 전부 필수적인 것으로 마킹합니다.\n서버가 요구 사항을 충족하지 못할 경우 협상에 실패할 수 있습니다.\n또한, 서버 측의 코덱 협상 정책에 따라 요구 사항이 무시될 수도 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将用户指定的所有编解码器相关要求标记为必须。\n如果服务器无法满足要求，协商可能会失败。\n此外，根据服务器端的编解码器协商策略，要求可能会被忽略。"
          }
        }
      }
    },
    "session-settings.projection.negotiation.optional" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibility First **(Recommended)**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換性優先 **(推奨)**"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "호환성 우선 **(권장)**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兼容性优先 **(推荐)**"
          }
        }
      }
    },
    "session-settings.projection.negotiation.optional_desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark all user-specified codec requirements as optional.\nAllows flexible negotiation, but requirements may not be fully met."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーが指定したコーデック関連の要求事項をすべて必須ではないものとしてマークします。\n柔軟にネゴシエーションが可能ですが、要求事項がすべて満たされない場合もあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "사용자가 지정한 코덱 관련 요구 사항을 전부 필수적이지 않은 것으로 마킹합니다.\n유연하게 협상이 가능하지만 요구 사항이 전부 충족되지 않을 수도 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将用户指定的所有编解码器相关要求标记为非必须。\n虽然可以灵活协商，但要求可能不会全部得到满足。"
          }
        }
      }
    },
