            "value" : "Allow File Copying (Experimental)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルのコピーを許可する（実験的）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "파일 복사 허용하기 (실험적)"
          }
