    "settings.input.exclusive_mode.unavailable.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclusive mode is unavailable because Accessibility permission is not granted.\nYou must restart Noctiluca Navigator after changing settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力監視の権限がないため、排他モードを使用できません。\n設定を変更した後、Noctiluca Navigatorを再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'손쉬운 사용' 권한이 주어지지 않아 독점 모드를 사용할 수 없습니다.\n설정을 변경한 후에는 Noctiluca Navigator를 다시 시작해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
