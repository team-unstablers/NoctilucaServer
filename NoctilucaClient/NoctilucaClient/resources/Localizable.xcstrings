    "main.address_bar.security.dangerous.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This host is using a certificate that is not trusted by the macOS trust store.\nThere is a risk that a third party could eavesdrop on or tamper with the remote control session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストはmacOSのトラストストアで信頼が拒否された証明書を使用しています。\n遠隔制御セッションの内容を第三者が盗聴したり改ざんする危険があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이 호스트는 macOS의 트러스트 스토어에서 신뢰가 거부된 인증서를 사용하고 있습니다.\n원격 제어 세션의 내용을 제 3자가 도청하거나 변조할 위험이 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主机使用的证书被 macOS 信任存储库拒绝信任。\n存在第三方窃听或篡改远程控制会话内容的风险。"
          }
        }
      }
    },
