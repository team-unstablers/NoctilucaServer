    "settings.projection.renderer_implementation.nocmetalvideorenderer.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a custom Metal-based video renderer. **Experimental**, but enables the CAS filter.\n- HDR display may be unstable due to experimental status."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自実装のMetalベースビデオレンダラーを使用します。**実験段階**ですが、CASフィルターが使用可能になります。\n- 実験段階のため、HDR表示が不安定になる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자체 구현된 Metal 기반의 비디오 렌더러를 사용합니다. **실험 단계**이지만, CAS 필터를 사용할 수 있게 됩니다.\n- 실험 단계이기 때문에 HDR 표시가 불안정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自研的基于Metal的视频渲染器。处于**实验阶段**，但可以启用CAS滤镜。\n- 由于处于实验阶段，HDR显示可能不稳定。"
          }
        }
      }
    },
