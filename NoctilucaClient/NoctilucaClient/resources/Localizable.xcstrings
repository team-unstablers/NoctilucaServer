    "auth.identity.help.consequences.mismatch.body_1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the worst case, passwords or confidential information may be leaked."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최악의 경우, 비밀번호나 기밀 정보가 유출될 수 있습니다."
          }
        }
      }
    },
    "auth.identity.help.consequences.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What happens if I continue?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "만약 계속 진행하면 어떻게 되나요?"
          }
        }
      }
    },
    "auth.identity.help.simple_explanation.mismatch.body_1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It seems another computer is trying to scam you by **faking its identity**."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "다른 컴퓨터가 **신분을 위조**해서 사기를 치려고 하는 것 같습니다."
          }
        }
      }
    },
    "auth.identity.help.simple_explanation.mismatch.body_2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noctiluca Navigator keeps a copy of the ID (certificate) of every computer it connects to. This warning is shown because the ID received this time does not match the one received previously."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Noctiluca Navigator는 접속하는 모든 컴퓨터의 신분증 (인증서)의 복사본을 받아둡니다. 이번에 받은 신분증은 저번에 받은 것과 일치하지 않았기 때문에 경고를 표시합니다."
          }
        }
      }
    },
    "auth.identity.help.simple_explanation.untrusted.body_1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This warning is shown because the authenticity of the ID (certificate) presented by the computer could not be verified.\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "컴퓨터가 제시한 신분증 (인증서)의 진위를 검증할 수 없기 때문에 이 경고가 표시되었습니다.\n"
          }
        }
      }
    },
    "auth.identity.help.simple_explanation.untrusted.body_2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When computers communicate with encryption, an ID (certificate) is required. There are two main ways to get a certificate.\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "컴퓨터끼리 암호화된 통신을 할 때는, 신분증 (인증서)이 필요합니다. 인증서를 발급 받는 방법은 크게 2가지가 있습니다.\n"
          }
        }
      }
    },
    "auth.identity.help.simple_explanation.untrusted.body_3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• **Get issued by a trusted CA**: This warning will not appear, but it costs money."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• **신뢰받는 인증 기관에서 발급받기**: 지금 보고 계신 것과 같은 경고가 표시되지 않게 되지만, 비용을 지불해야 합니다."
          }
        }
      }
    },
    "auth.identity.help.simple_explanation.untrusted.body_4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• **Issue a Self-Signed Certificate**: This is a way to create your own certificate. This error is shown because other computers cannot verify its authenticity.\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• **자가 서명 인증서 발급하기**: 자기 자신의 인증서를 직접 만드는 방법입니다. 다른 컴퓨터들이 진위를 검증할 수 없기 때문에 이러한 오류가 표시됩니다.\n"
          }
        }
      }
    },
    "auth.identity.help.simple_explanation.untrusted.body_5" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The computer you tried to connect to presented an ID of unknown authenticity."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이번에 접속을 시도한 컴퓨터는 진위를 알 수 없는 신분증을 제시하였습니다."
          }
        }
      }
    },
    "auth.identity.help.what_happened.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I don't understand what this means. Please explain it simply."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "무슨 의미인지 하나도 모르겠어요. 최대한 쉽게 설명해 주세요."
          }
        }
      }
    },
    "auth.identity.help.what_to_do.mismatch.body_1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• If you are working in an insecure internet environment (e.g., public Wi-Fi), disconnect and try again in a secure environment."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• 안전하지 않은 인터넷 환경 (공개된 Wi-Fi 등)에서 작업하고 있다면, 접속을 해제하고 안전이 보장되는 환경에서 다시 시도하십시오."
          }
        }
      }
    },
    "auth.identity.help.what_to_do.mismatch.body_2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• If you remember replacing the certificate recently, it is safe to proceed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• 만약 최근에 인증서를 직접 교체한 기억이 있으시다면 계속 진행하셔도 괜찮습니다."
          }
        }
      }
    },
    "auth.identity.help.what_to_do.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So what should I do?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그럼 저는 어떻게 해야 하나요?"
          }
        }
      }
    },
    "auth.identity.help.why_warning.mismatch.body_1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This warning can occur in the following situations:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이 경고는 다음과 같은 상황에서 발생할 수 있습니다:"
          }
        }
      }
    },
    "auth.identity.help.why_warning.mismatch.body_2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• The server administrator replaced the certificate."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• 서버 관리자가 인증서를 교체하였습니다."
          }
        }
      }
    },
    "auth.identity.help.why_warning.mismatch.body_3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• There is a possibility of a **Man-in-the-Middle (MITM) attack**: Someone might be trying to eavesdrop on or tamper with the communication for malicious purposes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• **중간자 공격**(MITM)의 가능성이 있습니다: 누군가가 악의적인 목적으로 통신 내용을 훔쳐보거나 변조하려 할 수도 있습니다."
          }
        }
      }
    },
    "auth.identity.help.why_warning.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why is this warning shown?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이 경고는 왜 표시되나요?"
          }
        }
      }
    },
    "auth.identity.help.why_warning.untrusted.body_1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This warning may be shown in the following situations:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이 경고는 다음과 같은 상황에서 표시될 수 있습니다:"
          }
        }
      }
    },
    "auth.identity.help.why_warning.untrusted.body_2" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• When using a self-signed certificate"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• 자가 서명 인증서를 사용한 경우"
          }
        }
      }
    },
    "auth.identity.help.why_warning.untrusted.body_3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• If the system trust store is outdated"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• 시스템의 트러스트 스토어가 낡은 상태인 경우"
          }
        }
      }
    },
    "auth.identity.help.why_warning.untrusted.body_4" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• If the system clock is incorrect and differs significantly from the actual time."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• 시스템의 시계가 틀어져 실제 시각과 커다란 차이가 나는 경우"
          }
        }
      }
    },
    "auth.identity.navigation_title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificate Verification Failed"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "인증서 검증 실패"
          }
        }
      }
