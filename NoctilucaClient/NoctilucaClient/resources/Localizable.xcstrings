    "session-settings.security.tls.default_desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accommodates the situation where not all hosts can get SSL/TLS certificates from trusted CAs.\nDisplays a warning popup for hosts using self-signed certificates."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのホストが信頼された認証局からSSL/TLS証明書を発行してもらえない状況を考慮します。\n自己署名証明書を使用したホストの場合、警告ポップアップを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 호스트가 신뢰받은 인증 기관으로부터 SSL/TLS 인증서를 발급받을 수 없다는 상황을 감안합니다.\n자가 서명 인증서를 사용한 호스트의 경우 경고 팝업을 표시합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "考虑到并非所有主机都能从受信任的证书颁发机构获取 SSL/TLS 证书的情况。\n如果是使用自签名证书的主机，则会显示警告弹窗。"
          }
        }
      }
    },
    "session-settings.security.tls.policy" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Validation Policy"
          }
