    "settings.projection.jitter_buffer.prioritize_stability.desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides stable playback resilient to network jitter by using a generous buffer.\nSome delay may occur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッファを余裕を持って確保し、ネットワークジッターに強い安定した再生を行います。\n多少の遅延が生じる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "버퍼를 넉넉하게 잡아 네트워크 지터에 강한 안정적인 재생을 합니다.\n딜레이가 다소 있을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过设置较大的缓冲来抵抗网络抖动，实现稳定的播放。\n可能会有一定的延迟。"
          }
        }
      }
    },
    "settings.projection.jitter_buffer.ultra_low_latency" : {
      "extractionState" : "extracted_with_value",
