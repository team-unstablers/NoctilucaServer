    "settings.input.mouse.footer.touch" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note:\n- Touch mode moves to the tapped location and clicks.\n- Dragging is handled directly as click+drag with one finger."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参考:\n- タッチモードはタップ時にその位置へ移動してからクリックします。\n- ドラッグは一本指ですぐにクリック+ドラッグとして処理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "참고:\n- 터치 모드는 탭 시 해당 위치로 이동 후 클릭합니다.\n- 드래그는 한 손가락으로 바로 클릭+드래그로 처리됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：\n- 触摸模式下，轻点时会先移动到该位置再点击。\n- 拖动操作为单指直接点击+拖动。"
          }
        }
      }
    },
    "settings.input.mouse.footer.trackpad" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note:\n- Trackpad mode moves the cursor using relative coordinates.\n- Dragging is performed via long press or two-finger gestures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参考:\n- トラックパッドモードは相対座標でカーソルを移動します。\n- ドラッグは長押しまたは2本指の組み合わせで実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "참고:\n- 트랙패드 모드는 상대 좌표로 커서를 이동합니다.\n- 드래그는 긴 누름 또는 두 손가락 조합으로 실행됩니다."
          }
        },
        "zh-Hans" : {
