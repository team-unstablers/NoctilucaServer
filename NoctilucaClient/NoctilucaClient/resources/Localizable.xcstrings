    "session-settings.projection.codec.color_format.yuv420_desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use YUV 4:2:0 color format. Compatible with most devices."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YUV 4:2:0 カラーフォーマットを使用します。ほとんどのデバイスで互換性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "YUV 4:2:0 색상 포맷을 사용합니다. 대부분의 기기에서 호환됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 YUV 4:2:0 色彩格式。兼容大多数设备。"
          }
        }
      }
    },
    "session-settings.projection.codec.color_format.yuv444_desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use YUV 4:4:4 color format.\nImproves text readability but increases bandwidth usage and may reduce compatibility."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YUV 4:4:4 カラーフォーマットを使用します。\nテキストの可読性は向上しますが、帯域幅の使用量が増え、互換性が低下する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
