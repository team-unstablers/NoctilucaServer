    "auth.identity.untrusted_format" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` presented a certificate, but the system trust store decided it cannot be trusted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@`で証明書を提示しましたが、システムのトラストストアでこれを信頼できないと判断しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "`%@`에서 인증서를 제시했지만, 시스템의 트러스트 스토어에서 이를 신뢰할 수 없다고 판단했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`%@` 出示了证书，但系统信任存储库判定该证书不可信。"
          }
        }
      }
    },
