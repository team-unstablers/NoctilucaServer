    "session-settings.projection.codec.lossless.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requests the server to use lossless compression.\nRequires a high-speed internet connection as it consumes significant network bandwidth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロスレス圧縮を使用するように要求します。\nかなりのネットワーク帯域幅を使用するため、高速なインターネット接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "무손실 압축을 사용하도록 요구합니다.\n상당한 네트워크 대역폭을 사용하기 때문에 빠른 속도의 인터넷 연결을 필요로 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求使用无损压缩。\n因为会消耗大量网络带宽，所以需要高速的互联网连接。"
          }
        }
      }
    },
