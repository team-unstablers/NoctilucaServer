    "session-settings.transfer.channel.compression.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure whether to use Zstd compression.\nThis may reduce data transfer volume, but may increase computing resource usage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zstd圧縮を使用するかどうかを設定します。\nデータ転送量が減少する可能性がありますが、コンピューティングリソースの使用量が増加する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zstd 압축을 사용할지 여부를 설정합니다.\n데이터 전송량이 줄어들 수 있지만, 컴퓨팅 자원 사용량이 늘어날 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置是否使用Zstd压缩。\n可能减少数据传输量，但可能增加计算资源使用量。"
          }
        }
      }
    },
    "session-settings.transfer.channel.compression.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
