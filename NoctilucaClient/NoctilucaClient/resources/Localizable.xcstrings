    "settings.projection.jitter_buffer.ultra_low_latency.desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioritizes minimizing latency.\nFrequent stuttering or frame drops may occur if the network condition is poor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅延の最小化を最優先します。\nネットワークの状態が良くない場合、途切れやフレームドロップが頻繁に発生する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지연 시간 최소화를 최우선으로 합니다.\n네트워크 상태가 좋지 않으면 끊김이나 프레임 드롭이 빈번해질 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先考虑最小化延迟。\n如果网络状况不佳，可能会频繁出现卡顿或丢帧。"
          }
        }
      }
    },
