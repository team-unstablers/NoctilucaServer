      }
    },
    "session-settings.transfer.clipboard.bidirectional_sync.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also allows clipboard synchronization from local to the remote host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル→リモートホストへのクリップボード同期も許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "로컬→원격 호스트로의 클립보드 동기화도 허용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也允许从本地到远程主机的剪贴板同步。"
          }
        }
      }
    },
    "session-settings.transfer.clipboard.bidirectional_sync.title" : {
      "extractionState" : "extracted_with_value",
