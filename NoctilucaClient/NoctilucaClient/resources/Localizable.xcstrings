    "settings.misc.hidio_qos.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request the MsQuic scheduler to apply high QoS priority to streams related to the HIDIO channel, striving to minimize input latency even in low-throughput environments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MsQuicスケジューラにHIDIOチャンネルに関連するストリームに対して高いQoS優先順位を適用するよう要求し、低いスループット環境でも入力遅延を最小化しようとします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MsQuic 스케줄러에게 HIDIO 채널과 관련된 스트림에 대해 높은 QoS 우선순위를 적용하도록 요청하여, 낮은 스루풋 환경에서도 입력 지연을 최소화 하기 위해 노력합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求 MsQuic 调度器对 HIDIO 通道相关流应用高 QoS 优先级，努力在低吞吐量环境下将输入延迟降至最低。"
          }
        }
      }
    },
    "settings.misc.hidio_qos.title" : {
      "extractionState" : "extracted_with_value",
