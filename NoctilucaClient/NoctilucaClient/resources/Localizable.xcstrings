    },
    "session-settings.projection.codec_list.template.webp.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use tiled WebP.\nBetter compression than MJPG but uses more resources.\nSuitable for displaying frequently changing content in virtual machine environments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイリングされたWebPを使用します。\nMJPGより圧縮効率が良いですがリソースをより多く使用します。\n仮想マシン環境で画面変更が頻繁なコンテンツを表示する必要がある場合に適しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "타일링된 WebP를 사용합니다.\nMJPG보다 압축 효율이 좋지만 리소스를 더 많이 사용합니다.\n가상 머신 환경에서 화면 변경이 잦은 컨텐츠를 표시해야 하는 경우 적합합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用平铺 WebP。\n压缩效率比 MJPG 好，但消耗更多资源。\n适合在虚拟机环境下显示画面变化频繁的内容。"
          }
        }
      }
    },
    "session-settings.projection.codec_list.template.webp.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
