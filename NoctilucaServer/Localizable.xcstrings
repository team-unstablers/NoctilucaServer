    "settings.projection.audio_codec_priority.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets the priority of audio codecs to be used by the server. During negotiation with the client, codecs with higher priority are attempted first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーで使用するオーディオコーデックの優先順位を設定します。クライアントとのネゴシエーション時、優先順位の高いコーデックから試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "서버에서 사용할 오디오 코덱의 우선순위를 설정합니다. 클라이언트와의 협상 시, 우선순위가 높은 코덱부터 시도합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置服务器使用的音频编解码器优先级。与客户端协商时，将优先尝试优先级高的编解码器。"
          }
        }
      }
    },
    "settings.projection.audio_codec_priority.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio Codec Priority Settings"
          }
        },
        "ja" : {
