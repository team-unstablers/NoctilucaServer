    "plugins.auth.NullAuthPlugin.description" : {
      "comment" : "Provides 'NULL' authentication that always succeeds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides 'NULL' authentication that always succeeds."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 인증에 성공하는 'NULL' 인증을 제공합니다. 이 플러그인은 개발 용도로만 사용되어야 합니다."
          }
        }
      }
    },
