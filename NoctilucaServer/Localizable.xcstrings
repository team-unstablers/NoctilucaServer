    "plugins.auth.SimplePasswordAuthPlugin.description" : {
      "comment" : "Provides password-only authentication using SHA-512 + Bcrypt.\nThis plugin is based on libbcrypt written by Ricardo Garcia (@rg3).\n@rg3's libbcrypt is distributed under the CC0-1.0 license, and the forked version by team unstablers Inc. for Noctiluca Server development can be found at https://github.com/team-unstablers/libbcrypt .",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides SHA-512 + bcrypt based password-only authentication.\n\nThis plugin is based on libbcrypt written by Ricardo Garcia (@rg3).\n@rg3's libbcrypt is distributed under CC0-1.0 license. The forked version by team unstablers Inc. for Noctiluca Server development can be found at https://github.com/team-unstablers/libbcrypt/."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-512 + bcrypt ベースのパスワードのみの認証を提供します。\n\nこのプラグインは Ricardo Garcia （@rg3） 氏が作成した libbcrypt に基づいています。\n@rg3 氏の libbcrypt は CC0-1.0 ライセンスの下で配布されており、team unstablers Inc. が Noctiluca Server 開発のためにフォークしたバージョンは https://github.com/team-unstablers/libbcrypt/ で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SHA-512 + bcrypt 기반의 password-only 인증을 제공합니다.\n\n이 플러그인은 Ricardo Garcia (@rg3) 님이 작성하신 libbcrypt를 기반으로 합니다.\n@rg3 님의 libbcrypt는 CC0-1.0 라이선스 하에 배포되고 있으며, team unstablers Inc. 에서 Noctiluca Server 개발을 위해 포크한 버전은 https://github.com/team-unstablers/libbcrypt/ 에서 확인하실 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供基于 SHA-512 + bcrypt 的仅密码认证。\n\n此插件基于 Ricardo Garcia (@rg3) 编写的 libbcrypt。\n@rg3 的 libbcrypt 在 CC0-1.0 许可证下分发，team unstablers Inc. 为 Noctiluca Server 开发而 Fork 的版本可以在 https://github.com/team-unstablers/libbcrypt/ 查看。"
          }
        }
      }
    },
    "plugins.auth.SimplePasswordAuthPlugin.name" : {
      "comment" : "SimplePasswordAuthPlugin",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple Password Auth Plugin"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡易パスワード認証プラグイン"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "간단 비밀번호 인증 플러그인"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简单密码认证插件"
          }
        }
      }
    },
    "plugins.auth.SSHAuthPlugin.description" : {
      "comment" : "Provides SSH public key authentication.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides SSH key-based authentication.\n\nThis plugin is based on the 'Xuanxue' Swift module written by team unstablers Inc.\nThe source code for Xuanxue can be found at https://github.com/team-unstablers/Xuanxue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHキーベースの認証を提供します。\n\nこのプラグインは team unstablers Inc. が作成した 'Xuanxue' Swiftモジュールに基づいています。\nXuanxueのソースコードは https://github.com/team-unstablers/Xuanxue で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SSH 키 기반의 인증을 제공합니다.\n\n이 플러그인은 team unstablers Inc.가 작성한 'Xuanxue' Swift 모듈을 기반으로 합니다.\nXuanxue의 소스 코드는 https://github.com/team-unstablers/Xuanxue 에서 확인하실 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供基于 SSH 密钥的认证。\n\n此插件基于 team unstablers Inc. 编写的 'Xuanxue' Swift 模块。\nXuanxue 的源代码可以在 https://github.com/team-unstablers/Xuanxue 查看。"
          }
        }
      }
    },
