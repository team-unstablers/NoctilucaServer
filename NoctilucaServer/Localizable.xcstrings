    "settings.app_stream.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AppStream은 Sirius 프로토콜의 프로젝션 채널을 활용하여, 앱 단위 프로젝션을 지원하는 실험적 기능입니다. 이 기능을 활성화하면, 클라이언트는 전체 디스플레이 대신 특정 앱의 창만 선택하여 프로젝션할 수 있습니다."
          }
        }
      }
    },
    "settings.app_stream.disable_common_shortcuts.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AppStream이 활성화 된 동안, ⌘+Tab 같은 앱 포커스를 뺏어갈 가능성이 있는 시스템 단축키를 무시하여, 프로젝션된 앱이 더 원활하게 작동하도록 합니다."
          }
        }
      }
    },
