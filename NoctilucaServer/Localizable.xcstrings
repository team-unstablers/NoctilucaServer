    "settings.projection.negotiation_policy.balanced.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selects the optimal codec respecting the client's request within a range that does not compromise server performance and stability.\nWhen a codec specification not supported by the server is requested, Noctiluca Server arbitrarily substitutes it with a codec it deems appropriate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クライアントの要求を尊重しつつ、サーバーの性能と安定性を損なわない範囲で最適なコーデックを選択します。\nサーバーがサポートできない仕様のコーデックが要求された場合は、Noctiluca Serverが適切と判断するコーデックに任意で代替します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "클라이언트의 요청을 존중하면서 서버의 성능과 안정성을 해치지 않는 범위 내에서 최적의 코덱을 선택합니다.\n서버가 지원할 수 없는 명세의 코덱이 요청되었을 때에는 Noctiluca Server가 적절하다고 판단하는 코덱으로 임의 대체합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在尊重客户端请求的同时，在不损害服务器性能和稳定性的范围内选择最佳编解码器。\n当请求了服务器无法支持的编解码器规格时，Noctiluca Server 将任意替换为它认为合适的编解码器。"
          }
        }
      }
    },
    "settings.projection.negotiation_policy.balanced.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make Balanced Decisions **(Recommended)**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランスの取れた決定を行う **（推奨）**"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "균형 잡힌 결정 내리기 **(권장)**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做出均衡决定 **(推荐)**"
          }
        }
      }
    },
    "settings.projection.negotiation_policy.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets the codec negotiation policy with the client."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クライアントとのコーデックネゴシエーションポリシーを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "클라이언트와의 코덱 협상 정책을 설정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置与客户端的编解码器协商策略。"
          }
        }
      }
    },
    "settings.projection.negotiation_policy.override_from_server.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completely ignores client requests and prioritizes server codec settings.\nConnection may fail if a codec not supported by the client is configured."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クライアントの要求を完全に無視し、サーバーのコーデック設定を優先します。\nクライアントがサポートしていないコーデックが設定されている場合、接続に失敗する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "클라이언트의 요청을 완전히 무시하고 서버의 코덱 설정을 우선시합니다.\n클라이언트가 지원하지 않는 코덱이 설정되어 있을 경우 연결에 실패할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全忽略客户端的请求，优先使用服务器的编解码器设置。\n如果设置了客户端不支持的编解码器，连接可能会失败。"
          }
        }
      }
    },
    "settings.projection.negotiation_policy.override_from_server.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
