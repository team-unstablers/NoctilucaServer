          }
        }
      }
    },
    "plugins.auth.SSHAuthPlugin.description" : {
      "comment" : "Provides SSH public key authentication.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides SSH key-based authentication.\n\nThis plugin is based on the 'Xuanxue' Swift module written by team unstablers Inc.\nThe source code for Xuanxue can be found at https://github.com/team-unstablers/Xuanxue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 키 기반의 인증을 제공합니다.\n\n이 플러그인은 team unstablers Inc.가 작성한 'Xuanxue' Swift 모듈을 기반으로 합니다.\nXuanxue의 소스 코드는 https://github.com/team-unstablers/Xuanxue 에서 확인하실 수 있습니다."
          }
        }
      }
