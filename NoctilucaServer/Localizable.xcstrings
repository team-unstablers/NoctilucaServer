    "settings.projection.codec_sheet.profile.h264_baseline_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses Baseline Profile for high compatibility.\nCompression rate and image quality are low because advanced codec features cannot be used."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換性の高いBaselineプロファイルを使用します。\nコーデックの高度な機能を使用できないため、圧縮率と画質は低くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "호환성이 높은 Baseline Profile을 사용합니다.\n코덱의 고급 기능을 사용할 수 없기 때문에 압축률과 화질이 낮습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用兼容性高的 Baseline Profile。\n由于无法使用编解码器的高级功能，压缩率和画质较低。"
          }
        }
      }
    },
