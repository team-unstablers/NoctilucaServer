    },
    "settings.projection.webp_sheet.quantize_level.strong_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies strong quantization. Compression improves significantly, but color banding may occur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強い量子化を適用します。圧縮率は大きく向上しますが、カラーバンディングが発生する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "강한 양자화를 적용합니다. 압축률이 크게 향상되지만, 색상 밴딩이 발생할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用强量化。压缩率大幅提高，但可能会出现色带（Color Banding）。"
          }
        }
      }
    },
