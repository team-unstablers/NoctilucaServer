    "settings.projection.rle_sheet.quantize_level.light_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies light quantization. Maintains color quality while slightly improving compression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽い量子化を適用します。色の品質を維持しながら圧縮率をわずかに向上させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "가벼운 양자화를 적용합니다. 색상 품질을 유지하면서 압축률을 약간 향상시킵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用轻度量化。在保持颜色质量的同时略微提高压缩率。"
          }
        }
      }
    },
    "settings.projection.rle_sheet.quantize_level.max" : {
