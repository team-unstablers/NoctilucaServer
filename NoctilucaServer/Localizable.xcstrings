    "plugins.auth.SimplePasswordAuthPlugin.description" : {
      "comment" : "Provides password-only authentication using SHA-512 + Bcrypt.\nThis plugin is based on libbcrypt written by Ricardo Garcia (@rg3).\n@rg3's libbcrypt is distributed under the CC0-1.0 license, and the forked version by team unstablers Inc. for Noctiluca Server development can be found at https://github.com/team-unstablers/libbcrypt .",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides SHA-512 + bcrypt based password-only authentication.\n\nThis plugin is based on libbcrypt written by Ricardo Garcia (@rg3).\n@rg3's libbcrypt is distributed under CC0-1.0 license. The forked version by team unstablers Inc. for Noctiluca Server development can be found at https://github.com/team-unstablers/libbcrypt/."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-512 + bcrypt 기반의 password-only 인증을 제공합니다.\n\n이 플러그인은 Ricardo Garcia (@rg3) 님이 작성하신 libbcrypt를 기반으로 합니다.\n@rg3 님의 libbcrypt는 CC0-1.0 라이선스 하에 배포되고 있으며, team unstablers Inc. 에서 Noctiluca Server 개발을 위해 포크한 버전은 https://github.com/team-unstablers/libbcrypt/ 에서 확인하실 수 있습니다."
          }
        }
      }
    },
    "plugins.auth.SimplePasswordAuthPlugin.name" : {
      "comment" : "SimplePasswordAuthPlugin",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
