    "settings.projection.mjpg_sheet.quantize_level.maximum_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies maximum quantization. Severe color loss occurs, but compression is maximized."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大量子化を適用します。深刻な色の損失が発生しますが、圧縮率は最大化されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최대 양자화를 적용합니다. 심각한 색상 손실이 발생하지만, 압축률이 극대화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用最大量化。虽然会发生严重的颜色损失，但压缩率达到最大化。"
          }
        }
      }
    },
    "settings.projection.mjpg_sheet.quantize_level.medium_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies medium quantization. Improves compression in gradient areas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中程度の量子化を適用します。グラデーション領域での圧縮率が向上します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "중간 양자화를 적용합니다. 그라데이션 영역에서 압축률이 향상됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
