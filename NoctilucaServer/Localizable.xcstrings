    "settings.misc.transport_layer_implemenation.apple_quic.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses Apple's QUIC implementation provided by default in macOS.\nSome features may not work properly, or performance may be low."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS標準のApple製QUIC実装を使用します。\n一部の機能が正常に動作しなかったり、性能が低下したりする可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS에서 기본으로 제공되는 Apple의 QUIC 구현체를 사용합니다.\n일부 기능이 제대로 동작하지 않거나, 낮은 성능을 낼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 macOS 默认提供的 Apple QUIC 实现。\n部分功能可能无法正常工作，或性能较低。"
          }
        }
      }
    },
