    "settings.projection.codec_sheet.quality.auto_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically determines the video quality based on the network environment and client's computing speed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク環境とクライアントのコンピューティング速度に合わせて、自動的に画面の品質を決定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "네트워크 환경과 클라이언트의 컴퓨팅 속도에 맞춰 자동으로 화면 품질을 결정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据网络环境和客户端的计算速度自动决定画面质量。"
          }
        }
      }
