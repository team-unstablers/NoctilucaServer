          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HIDPI / Retina ディスプレイ密度の使用を試みます。\nより良い画質を提供しますが、高い帯域幅と計算リソースを使用します。"
          }
