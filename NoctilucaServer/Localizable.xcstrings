    "settings.projection.mjpg_sheet.color_format.yuv444_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses YUV 4:4:4 color format.\nImproves text readability but increases bandwidth usage and may reduce compatibility."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YUV 4:4:4 カラーフォーマットを使用します。\nテキストの可読性は向上しますが、帯域幅の使用量が増え、互換性が低下する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "YUV 4:4:4 색상 포맷을 사용합니다.\n텍스트 가독성이 향상되지만, 대역폭 사용량이 늘어나고 호환성이 떨어질 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 YUV 4:4:4 颜色格式。\n提高文本可读性，但会增加带宽使用量且可能降低兼容性。"
          }
        }
      }
    },
    "settings.projection.mjpg_sheet.compression_quality.high_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sets to high quality %lld, which is not typically used in remote control.** Provides very high image quality but increases bandwidth usage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**リモート制御では通常使用されない高品質 %lld に設定します。** 非常に高い画質を提供しますが、帯域幅の使用量が増加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**원격 제어에서 통상적으로 사용되지 않는 높은 품질 %lld로 설정합니다.** 매우 높은 화질을 제공하지만, 대역폭 사용량이 증가합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**设置为远程控制通常不使用的高质量 %lld。** 提供极高的画质，但会增加带宽使用量。"
          }
        }
      }
    },
    "settings.projection.mjpg_sheet.compression_quality.lossless_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Uses lossless compression.** Provides very high image quality but abnormally increases bandwidth usage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**可逆圧縮を使用します。** 非常に高い画質を提供しますが、帯域幅の使用量が異常に増加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**무손실 압축을 사용합니다.** 매우 높은 화질을 제공하지만, 대역폭 사용량이 비정상적으로 증가합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
