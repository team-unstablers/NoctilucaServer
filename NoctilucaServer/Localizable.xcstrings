        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern video codec providing higher compression efficiency than H.264."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264よりも高い圧縮効率を提供する最新のビデオコーデックです。"
          }
        },
        "ko" : {
          "stringUnit" : {
