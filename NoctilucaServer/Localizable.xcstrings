    "settings.projection.codec_sheet.quality.lossless_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses lossless compression.\nRequires a fast internet connection as it consumes significant network bandwidth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可逆圧縮を使用します。\nかなりのネットワーク帯域幅を使用するため、高速なインターネット接続が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "무손실 압축을 사용합니다.\n상당한 네트워크 대역폭을 사용하기 때문에 빠른 속도의 인터넷 연결을 필요로 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用无损压缩。\n由于占用大量网络带宽，因此需要高速的互联网连接。"
          }
        }
      }
    },
