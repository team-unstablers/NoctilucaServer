    },
    "settings.projection.codec_add.mjpg.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better compression efficiency than JPEG but uses more resources.\nSuitable for displaying content with frequent screen changes in virtual machine environments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JPEGよりも圧縮効率は良いですが、リソースをより多く消費します。\n仮想マシン環境などで画面変化が頻繁なコンテンツを表示する場合に適しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "JPEG보다 압축 효율이 좋지만 리소스를 더 많이 사용합니다.\n가상 머신 환경에서 화면 변경이 잦은 컨텐츠를 표시해야 하는 경우 적합합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比 JPEG 压缩效率更好，但占用更多资源。\n适用于在虚拟机环境中需要显示画面变化频繁的内容的情况。"
          }
        }
      }
    },
    "settings.projection.codec_add.mjpg.title" : {
