    "settings.plugins.security_policy.allow_any.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows all plugins, including ad-hoc signed ones.\n**Malicious plugins may damage the system.**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad-hoc署名されたプラグインを含む、すべてのプラグインを許可します。\n**悪意のあるプラグインによってシステムが損害を受ける可能性があります。**"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ad-hoc 서명된 플러그인을 포함하여 모든 플러그인을 허용합니다.\n**악성 플러그인에 의해 시스템이 손상될 수 있습니다.**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许包括 Ad-hoc 签名插件在内的所有插件。\n**恶意插件可能会损坏系统。**"
          }
        }
      }
    },
    "settings.plugins.security_policy.allow_any.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow All Plugins **(Dangerous!)**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのプラグインを許可 **（危険！）**"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "모든 플러그인 허용 **(위험!)**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许所有插件 **(危险!)**"
          }
        }
      }
    },
    "settings.plugins.security_policy.allow_signed.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows all plugins signed by Apple-trusted developers.\n**Even if trusted by Apple, there may be unsafe plugins.**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleから信頼された開発者によって署名されたすべてのプラグインを許可します。\n**Appleから信頼されていても、安全でないプラグインが存在する可能性があります**"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apple로부터 신뢰받은 개발자들이 서명한 모든 플러그인을 허용합니다.\n**Apple로부터 신뢰를 받았더라도 안전하지 않은 플러그인이 있을 수 있습니다**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许所有由 Apple 信任的开发者签名的插件。\n**即使得到了 Apple 的信任，也可能存在不安全的插件**"
          }
        }
      }
    },
    "settings.plugins.security_policy.allow_signed.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Signed Plugins Only **(Dangerous!)**"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名されたプラグインのみ許可 **（危険！）**"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "서명된 플러그인만 허용 **(위험!)**"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅允许已签名插件 **(危险!)**"
          }
        }
      }
    },
    "settings.plugins.security_policy.allow_team_unstablers.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows only official plugins provided by team unstablers Inc., the developer of Noctiluca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noctilucaの開発元である team unstablers Inc. が提供する公式プラグインのみ許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Noctiluca의 개발사인 team unstablers Inc.에서 제공하는 공식 플러그인만 허용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅允许 Noctiluca 的开发商 team unstablers Inc. 提供的官方插件。"
          }
        }
      }
    },
    "settings.plugins.security_policy.allow_team_unstablers.title" : {
