lizations":{"ko":{"stringUnit":{"state":"new","value":"전체 색상 범위 %@를 사용합니다.\n색상 재현이 더 좋지만, 일부 기기에서 호환성 문제가 발생할 수 있습니다."}},"en":{"stringUnit":{"value":"Uses full color range %@.\nColor reproduction is better, but compatibility issues may occur on some devices.","state":"translated"}}},"extractionState":"extracted_with_value"},"settings.projection.rle_sheet.resolution.level_description":{"extractionState":"extracted_with_value","localizations":{"ko":{"stringUnit":{"value":"최대 해상도를 %@으로 설정합니다.","state":"new"}},"en":{"stringUnit":{"state":"translated","value":"Sets max resolution to %@."}}}},"settings.projection.audio_codec.pcmu.description":{"localizations":{"ko":{"stringUnit":{"state":"new","value":"전통적인 전화망에서 사용되는 표준 코덱입니다. 호환성이 높습니다."}},"en":{"stringUnit":{"state":"translated","value":"Standard codec used in traditional telephone networks. High compatibility."}}},"extractionState":"extracted_with_value"},"settings.projection.codec_sheet.display_density.best_description":{"localizations":{"ko":{"stringUnit":{"value":"HIDPI / Retina 디스플레이 밀도를 사용하려 노력합니다.\n더 나은 화질을 제공하지만, 높은 대역폭과 컴퓨팅 자원을 사용합니다.","state":"new"}},"en":{"stringUnit":{"state":"translated","value":"Attempts to use HIDPI / Retina display density.\nProvides better image quality but uses high bandwidth and computing resources."}}},"extractionState":"extracted_with_value"},"settings.about.license.no":{"extractionState":"extracted_with_value","localizations":{"en":{"stringUnit":{"value":"No","state":"translated"}},"ko":{"stringUnit":{"value":"아니오","state":"new"}}}},"plugins.auth.SimplePasswordAuthPlugin.description":{"comment":"Provides password-only authentication using SHA-512 + Bcrypt.\nThis plugin is based on libbcrypt written by Ricardo Garcia (@rg3).\n@rg3's libbcrypt is distributed under the CC0-1.0 license, and the forked version by team unstablers Inc. for Noctiluca Server development can be found at https://github.com/team-unstablers/libbcrypt .","localizations":{"en":{"stringUnit":{"value":"Provides SHA-512 + bcrypt based password-only authentication.\n\nThis plugin is based on libbcrypt written by Ricardo Garcia (@rg3).\n@rg3's libbcrypt is distributed under CC0-1.0 license. The forked version by team unstablers Inc. for Noctiluca Server development can be found at https://github.com/team-unstablers/libbcrypt/.","state":"translated"}},"ko":{"stringUnit":{"value":"SHA-512 + bcrypt 기반의 password-only 인증을 제공합니다.\n\n이 플러그인은 Ricardo Garcia (@rg3) 님이 작성하신 libbcrypt를 기반으로 합니다.\n@rg3 님의 libbcrypt는 CC0-1.0 라이선스 하에 배포되고 있으며, team unstablers Inc. 에서 Noctiluca Server 개발을 위해 포크한 버전은 https://github.com/team-unstablers/libbcrypt/ 에서 확인하실 수 있습니다.","state":"translated"}}}},"settings.projection.negotiation_policy.title":{"extractionState":"extracted_with_value","localizations":{"ko":{"stringUnit":{"state":"new","value":"코덱 협상 정책"}},"en":{"stringUnit":{"value":"Codec Negotiation Policy","state":"translated"}}}},"notification.server_stopped.message":{"extractionState":"extracted_with_value","localizations":{"en":{"stringUnit":{"value":"Server stopped.","state":"translated"}},"ko":{"stringUnit":{"value":"서버가 종료되었습니다.","state":"new"}}}},"settings.projection.webp_sheet.quantize_level.min":{"localizations":{"en":{"stringUnit":{"value":"0 (None)","state":"translated"}},"ko":{"stringUnit":{"value":"0 (없음)","state":"new"}}},"extractionState":"extracted_with_value"},"settings.projection.codec_add.description":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select codec type to add."}},"ko":{"stringUnit":{"state":"new","value":"추가할 코덱 유형을 선택하세요."}}},"extractionState":"extracted_with_value"},"settings.security.server_certificate.load_failed":{"extractionState":"extracted_with_value","localizations":{"en":{"stringUnit":{"value":"Could not load certificate info.","state":"translated"}},"ko":{"stringUnit":{"value":"인증서 정보를 불러올 수 없습니다.","state":"new"}}}},"settings.projection.codec_sheet.hardware_acceleration.description":{"localizations":{"ko":{"stringUnit":{"value":"하드웨어 가속 사