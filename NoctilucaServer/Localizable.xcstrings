    "settings.projection.codec_add.zrle.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitmap-based video codec used in traditional remote desktop environments.\nSuitable for displaying text-heavy content with few screen changes in virtual machine environments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "従来のリモートデスクトップ環境で使用されるビットマップ方式のビデオコーデックです。\n仮想マシン環境などで画面変化が少ないテキスト中心のコンテンツを表示する場合に適しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "전통적인 원격 데스크톱 환경에서 사용되는 비트맵 방식의 비디오 코덱입니다.\n가상 머신 환경에서 화면 변경이 적은 텍스트 위주의 컨텐츠를 표시해야 하는 경우 적합합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传统远程桌面环境中使用的位图方式视频编解码器。\n适用于在虚拟机环境中需要显示画面变化较少的文本为主的内容的情况。"
          }
        }
      }
    },
    "settings.projection.codec_add.zrle.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RLE + Zstd"
          }
