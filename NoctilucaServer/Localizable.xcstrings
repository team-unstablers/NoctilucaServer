          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "量子化を使用しません。元の色を維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "양자화를 사용하지 않습니다. 원본 색상을 유지합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
