    "settings.projection.mjpg_sheet.header_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MJPG codec uses [tile encoding](https://google.com).\nNoctiluca Server's MJPG encoder uses [libjpeg-turbo](https://libjpeg-turbo.org/), and is provided with the official binary of libjpeg-turbo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MJPGコーデックは[タイルエンコーディング](https://google.com)を使用します。\nNoctiluca ServerのMJPGエンコーダは[libjpeg-turbo](https://libjpeg-turbo.org/)を使用しており、libjpeg-turboの公式バイナリを同梱して提供されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MJPG 코덱은 [타일 인코딩](https://google.com)을 사용합니다.\nNoctiluca Server의 MJPG 인코더는 [libjpeg-turbo](https://libjpeg-turbo.org/)를 사용하며, libjpeg-turbo의 공식 바이너리를 동봉하여 제공됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MJPG 编解码器使用[瓦片编码](https://google.com)。\nNoctiluca Server 的 MJPG 编码器使用 [libjpeg-turbo](https://libjpeg-turbo.org/)，并附带 libjpeg-turbo 的官方二进制文件。"
          }
        }
      }
    },
    "settings.projection.mjpg_sheet.quantize_level.light_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies light quantization. Maintains color quality while slightly improving compression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽い量子化を適用します。色の品質を維持しながら圧縮率をわずかに向上させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "가벼운 양자화를 적용합니다. 색상 품질을 유지하면서 압축률을 약간 향상시킵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用轻度量化。在保持颜色质量的同时略微提高压缩率。"
          }
        }
      }
    },
    "settings.projection.mjpg_sheet.quantize_level.max" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
