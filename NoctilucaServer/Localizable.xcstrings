    "settings.projection.mjpg_sheet.dqt.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamically determines appropriate compression quality for each tile using DQT and custom quality decision algorithms."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DQTおよび独自の品質決定アルゴリズムを使用して、各タイルごとに適切な圧縮品質を動的に決定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DQT 및 자체 품질 결정 알고리즘을 사용하여 각 타일마다 적절한 압축 품질을 동적으로 결정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 DQT 及自有质量决策算法，为每个瓦片动态决定适当的压缩质量。"
          }
        }
      }
    },
