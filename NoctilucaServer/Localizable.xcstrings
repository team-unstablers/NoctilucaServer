          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供比 H.264 更高压缩效率的最新视频编解码器。"
          }
        }
      }
    },
    "settings.projection.codec_add.hevc.title" : {
