    "settings.projection.webp_sheet.header_description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The WebP codec uses tile encoding.\nIt provides higher compression efficiency than JPEG but uses more resources during encoding."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebPコーデックはタイルエンコーディングを使用します。\nJPEGよりも高い圧縮効率を提供しますが、エンコード時により多くのリソースを消費します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "WebP 코덱은 타일 인코딩을 사용합니다.\nJPEG보다 높은 압축 효율을 제공하지만, 인코딩 시 더 많은 리소스를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebP 编解码器使用瓦片编码。\n它提供比 JPEG 更高的压缩效率，但在编码时会占用更多资源。"
          }
        }
      }
    },
    "settings.projection.webp_sheet.quantize_level.light_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies light quantization. Maintains color quality while slightly improving compression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽い量子化を適用します。色の品質を維持しながら圧縮率をわずかに向上させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "가벼운 양자화를 적용합니다. 색상 품질을 유지하면서 압축률을 약간 향상시킵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用轻度量化。在保持颜色质量的同时略微提高压缩率。"
          }
        }
      }
    },
    "settings.projection.webp_sheet.quantize_level.max" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 (Max)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 （最大）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "5 (최대)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 (最大)"
          }
        }
      }
    },
    "settings.projection.webp_sheet.quantize_level.maximum_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies maximum quantization. Severe color loss occurs, but compression is maximized."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大量子化を適用します。深刻な色の損失が発生しますが、圧縮率は最大化されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최대 양자화를 적용합니다. 심각한 색상 손실이 발생하지만, 압축률이 극대화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用最大量化。虽然会发生严重的颜色损失，但压缩率达到最大化。"
          }
        }
      }
    },
    "settings.projection.webp_sheet.quantize_level.medium_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies medium quantization. Improves compression in gradient areas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中程度の量子化を適用します。グラデーション領域での圧縮率が向上します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "중간 양자화를 적용합니다. 그라데이션 영역에서 압축률이 향상됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用中等量化。提高渐变区域的压缩率。"
          }
        }
      }
    },
    "settings.projection.webp_sheet.quantize_level.min" : {
