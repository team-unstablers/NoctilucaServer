    "settings.plugins.security_policy.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets security policy for external plugins. Noctiluca Server must be restarted to apply this setting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部プラグインに対するセキュリティポリシーを設定します。この設定を適用するには、Noctiluca Serverを再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "외부 플러그인에 대한 보안 정책을 설정합니다. 이 설정을 적용하려면 Noctiluca Server를 다시 기동해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置外部插件的安全策略。要应用此设置，必须重启 Noctiluca Server。"
          }
        }
      }
    },
    "settings.plugins.security_policy.disallow_all.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocks all except plugins built-in or bundled with Noctiluca Server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noctiluca Serverに内蔵またはバンドルされたプラグイン以外はすべてブロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Noctiluca Server에 내장되거나 번들된 플러그인 외에는 모두 차단합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除 Noctiluca Server 内置或捆绑的插件外，阻止所有其他插件。"
