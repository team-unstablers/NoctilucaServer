    "server.identity_error.conflicting.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot start the server because multiple certificates named '%@' were found in the Keychain.\nRemove the duplicate certificates from Keychain Access and start the server again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychainで '%@' という名前の証明書が複数見つかったため、サーバーを起動できません。\nKeychain Accessアプリから重複した証明書を削除した後、サーバーを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keychain에서 '%@' 이름을 가진 인증서가 여러 개 발견되어 서버를 기동할 수 없습니다.\nKeychain Access 앱으로부터 중복된 인증서들을 제거 후 다시 서버를 기동하여 주십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在钥匙串中发现多个名为 '%@' 的证书，无法启动服务器。\n请从钥匙串访问应用程序中删除重复的证书后重新启动服务器。"
          }
        }
      }
    },
